+# 鍏ㄦ爤鐢ㄦ埛绠＄悊绯荤粺 - Makefile 蹇嵎鍛戒护
+
+.PHONY: help dev build up down restart logs clean build-backend build-frontend
+
+# 榛樿鐩爣锛氭樉绀哄府鍔?+help:
+	@echo "=== 鍏ㄦ爤鐢ㄦ埛绠＄悊绯荤粺 蹇嵎鍛戒护 ==="
+	@echo ""
+	@echo "寮€鍙戞ā寮?"
+	@echo "  make dev              - 鍚姩寮€鍙戠幆澧冿紙鍓嶅彴鍚庡彴骞惰鍚姩锛?
+	@echo ""
+	@echo "Docker 妯″紡:"
+	@echo "  make build            - 鏋勫缓鎵€鏈?Docker 闀滃儚"
+	@echo "  make up               - 鍚姩鎵€鏈夋湇鍔★紙鍚庡彴妯″紡锛?
+	@echo "  make down             - 鍋滄骞剁Щ闄ゆ墍鏈夋湇鍔?
+	@echo "  make restart          - 閲嶅惎鎵€鏈夋湇鍔?
+	@echo ""
+	@echo "鏃ュ織鏌ョ湅:"
+	@echo "  make logs             - 鏌ョ湅鎵€鏈夋湇鍔℃棩蹇?
+	@echo "  make logs-backend     - 鏌ョ湅鍚庣鏃ュ織"
+	@echo "  make logs-frontend    - 鏌ョ湅鍓嶇鏃ュ織"
+	@echo "  make logs-db          - 鏌ョ湅鏁版嵁搴撴棩蹇?
+	@echo ""
+	@echo "鏋勫缓鍛戒护:"
+	@echo "  make build-backend    - 鏋勫缓鍚庣椤圭洰"
+	@echo "  make build-frontend   - 鏋勫缓鍓嶇椤圭洰"
+	@echo ""
+	@echo "娓呯悊鍛戒护:"
+	@echo "  make clean            - 娓呯悊鏋勫缓浜х墿鍜?Docker 璧勬簮"
+
+# 寮€鍙戞ā寮忥細鍓嶅悗鍙板苟琛屽惎鍔?+dev:
+	@echo "鍚姩寮€鍙戠幆澧?.."
+	@echo "鍚庣: http://localhost:8080"
+	@echo "鍓嶇: http://localhost:5173"
+	@echo ""
+	@echo "璇峰湪涓や釜缁堢鍒嗗埆鎵ц浠ヤ笅鍛戒护:"
+	@echo "鍚庣: cd backend && mvn spring-boot:run"
+	@echo "鍓嶇: cd frontend && npm run dev"
+
+# Docker 鍛戒护
+build:
+	docker compose build
+
+up:
+	docker compose up -d
+
+down:
+	docker compose down
+
+restart:
+	docker compose restart
+
+# 鏃ュ織鍛戒护
+logs:
+	docker compose logs -f
+
+logs-backend:
+	docker compose logs -f backend
+
+logs-frontend:
+	docker compose logs -f frontend
+
+logs-db:
+	docker compose logs -f db
+
+# 椤圭洰鏋勫缓鍛戒护
+build-backend:
+	cd backend && mvn clean package -DskipTests
+
+build-frontend:
+	cd frontend && npm install && npm run build
+
+# 娓呯悊鍛戒护
+clean:
+	docker compose down -v --rmi local
+	cd backend && mvn clean
+	cd frontend && rm -rf dist node_modules
+	@echo "娓呯悊瀹屾垚"
