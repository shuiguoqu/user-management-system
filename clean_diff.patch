diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000..1910142
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,50 @@
+name: CI
+
+on:
+  push:
+    branches: [main, master, develop]
+  pull_request:
+    branches: [main, master, develop]
+
+jobs:
+  backend:
+    name: Backend Build & Test
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@v4
+
+      - name: Set up JDK 17
+        uses: actions/setup-java@v4
+        with:
+          java-version: '17'
+          distribution: 'temurin'
+          cache: 'maven'
+
+      - name: Build and test with Maven
+        working-directory: ./backend
+        run: mvn verify -B
+
+  frontend:
+    name: Frontend Build
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@v4
+
+      - name: Set up Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: '20'
+          cache: 'npm'
+          cache-dependency-path: ./frontend/package-lock.json
+
+      - name: Install dependencies
+        working-directory: ./frontend
+        run: npm ci
+
+      - name: Build frontend
+        working-directory: ./frontend
+        run: npm run build
diff --git a/Makefile b/Makefile
new file mode 100644
index 0000000..77031aa
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,62 @@
+.PHONY: help dev build start stop restart logs clean
+
+# 榛樿鐩爣
+help:
+	@echo "鐢ㄦ埛绠＄悊绯荤粺 - 蹇嵎鍛戒护"
+	@echo ""
+	@echo "鍙敤鍛戒护:"
+	@echo "  make dev     - 鍚姩寮€鍙戠幆澧?(docker-compose up -d)"
+	@echo "  make build   - 閲嶆柊鏋勫缓骞跺惎鍔?(docker-compose up -d --build)"
+	@echo "  make start   - 鍚姩鎵€鏈夋湇鍔?
+	@echo "  make stop    - 鍋滄鎵€鏈夋湇鍔?
+	@echo "  make restart - 閲嶅惎鎵€鏈夋湇鍔?
+	@echo "  make logs    - 鏌ョ湅鏃ュ織"
+	@echo "  make clean   - 鍋滄鏈嶅姟骞跺垹闄ゅ嵎 (鏁版嵁灏嗚娓呴櫎)"
+	@echo "  make ps      - 鏌ョ湅杩愯鐘舵€?
+	@echo "  make backend-logs  - 鏌ョ湅鍚庣鏃ュ織"
+	@echo "  make frontend-logs - 鏌ョ湅鍓嶇鏃ュ織"
+	@echo "  make db-logs       - 鏌ョ湅鏁版嵁搴撴棩蹇?
+
+# 寮€鍙戠幆澧?- 鍚姩鏈嶅姟
+dev:
+	docker-compose up -d
+
+# 閲嶆柊鏋勫缓骞跺惎鍔?+build:
+	docker-compose up -d --build
+
+# 鍚姩鏈嶅姟
+start:
+	docker-compose start
+
+# 鍋滄鏈嶅姟
+stop:
+	docker-compose stop
+
+# 閲嶅惎鏈嶅姟
+restart:
+	docker-compose restart
+
+# 鏌ョ湅鏃ュ織
+logs:
+	docker-compose logs -f
+
+# 鏌ョ湅鍚庣鏃ュ織
+backend-logs:
+	docker-compose logs -f backend
+
+# 鏌ョ湅鍓嶇鏃ュ織
+frontend-logs:
+	docker-compose logs -f frontend
+
+# 鏌ョ湅鏁版嵁搴撴棩蹇?+db-logs:
+	docker-compose logs -f db
+
+# 娓呯悊鐜锛堝寘鎷暟鎹嵎锛?+clean:
+	docker-compose down -v
+
+# 鏌ョ湅杩愯鐘舵€?+ps:
+	docker-compose ps
