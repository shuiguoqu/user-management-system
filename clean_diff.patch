+            assertThrows(Exception.class, () -> {
+                jwtUtil.getUsernameFromToken("");
+            });
+        }
+
+        @Test
+        @DisplayName("瑙ｆ瀽 Token - null Token鎶涘嚭寮傚父")
+        void getUsernameFromToken_NullToken_ThrowsException() {
+            assertThrows(Exception.class, () -> {
+                jwtUtil.getUsernameFromToken(null);
+            });
+        }
+
+        @Test
+        @DisplayName("瑙ｆ瀽 Token - 鏍煎紡閿欒鐨凾oken鎶涘嚭寮傚父")
+        void getUsernameFromToken_MalformedToken_ThrowsException() {
+            String malformedToken = "invalid.token.format";
+
+            assertThrows(Exception.class, () -> {
+                jwtUtil.getUsernameFromToken(malformedToken);
+            });
+        }
+
+        @Test
+        @DisplayName("瑙ｆ瀽 Token - 琚鏀圭殑Token鎶涘嚭寮傚父")
+        void getUsernameFromToken_TamperedToken_ThrowsException() {
+            String token = jwtUtil.generateToken(TEST_USERNAME);
+            String tamperedToken = token + "tampered";
+
+            assertThrows(Exception.class, () -> {
+                jwtUtil.getUsernameFromToken(tamperedToken);
+            });
+        }
+    }
+
+    @Nested
+    @DisplayName("Token 楠岃瘉娴嬭瘯")
+    class ValidateTokenTests {
+
+        @Test
+        @DisplayName("楠岃瘉 Token - 鏈夋晥Token杩斿洖true")
+        void validateToken_ValidToken_ReturnsTrue() {
+            String token = jwtUtil.generateToken(TEST_USERNAME);
+
+            boolean isValid = jwtUtil.validateToken(token);
+
+            assertTrue(isValid);
+        }
+
+        @Test
+        @DisplayName("楠岃瘉 Token - 绌篢oken杩斿洖false")
+        void validateToken_EmptyToken_ReturnsFalse() {
+            boolean isValid = jwtUtil.validateToken("");
+
+            assertFalse(isValid);
+        }
+
+        @Test
+        @DisplayName("楠岃瘉 Token - null Token杩斿洖false")
+        void validateToken_NullToken_ReturnsFalse() {
+            boolean isValid = jwtUtil.validateToken(null);
+
+            assertFalse(isValid);
+        }
+
+        @Test
+        @DisplayName("楠岃瘉 Token - 鏍煎紡閿欒鐨凾oken杩斿洖false")
+        void validateToken_MalformedToken_ReturnsFalse() {
+            boolean isValid = jwtUtil.validateToken("invalid.token.format");
+
+            assertFalse(isValid);
+        }
+
+        @Test
+        @DisplayName("楠岃瘉 Token - 琚鏀圭殑Token杩斿洖false")
+        void validateToken_TamperedToken_ReturnsFalse() {
+            String token = jwtUtil.generateToken(TEST_USERNAME);
+            String tamperedToken = token.substring(0, token.length() - 5) + "xxxxx";
+
+            boolean isValid = jwtUtil.validateToken(tamperedToken);
+
+            assertFalse(isValid);
+        }
+
+        @Test
+        @DisplayName("楠岃瘉 Token - 浣跨敤涓嶅悓瀵嗛挜绛惧悕鐨凾oken杩斿洖false")
+        void validateToken_DifferentSecret_ReturnsFalse() {
